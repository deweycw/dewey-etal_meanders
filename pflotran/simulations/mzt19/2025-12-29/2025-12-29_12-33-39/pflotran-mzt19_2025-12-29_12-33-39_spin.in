#==================== SIMULATION ==================== 
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
    SUBSURFACE_TRANSPORT transport 
      MODE GIRT 
    /
  /
  CHECKPOINT
    TIMES y 1. 
  /
END

SUBSURFACE
  #==================== GRID ====================
  GRID
    TYPE structured     
    NXYZ 1 108 26
    DXYZ
      1.d0
      0.5d0
      0.10d0
    /
  END

  #==================== STRATA ===================
  STRATA
    FILE ../../xxgrid010-mz-cxc-top.h5
  END

  #=========================== MATERIAL PROPERTIES ==============================
  MATERIAL_PROPERTY gravel
    ID  1
    POROSITY 0.2
    CHARACTERISTIC_CURVES sf
    PERMEABILITY 
      PERM_X  5.26E-11
      PERM_Y  5.26E-11
      PERM_Z  5.26E-11
    /
  /

  MATERIAL_PROPERTY  topsoil
    ID  2
    POROSITY 0.40
    CHARACTERISTIC_CURVES sf
    PERMEABILITY 
      PERM_X  1.055E-12
      PERM_Y  1.055E-12
      PERM_Z  1.055E-12
    /
  /

  #=====================CHARACTERISTIC CURVES============
  CHARACTERISTIC_CURVES sf
    SATURATION_FUNCTION VAN_GENUCHTEN
      M 0.286
      ALPHA 1.9401d-4
      LIQUID_RESIDUAL_SATURATION 0.115
    /
    PERMEABILITY_FUNCTION MUALEM_VG_LIQ
      M 0.5
      LIQUID_RESIDUAL_SATURATION 0.115
    /
  /

  #=========================== fluid properties =================================
  FLUID_PROPERTY
    PHASE LIQUID
    DIFFUSION_COEFFICIENT 1.d-9
  END

  FLUID_PROPERTY
    PHASE GAS
    DIFFUSION_COEFFICIENT 2.1d-5
  END

  #===================OUTPUT=====================
  OUTPUT
    VELOCITY_AT_CENTER
    TIME_UNITS y
    SNAPSHOT_FILE
      FORMAT HDF5
      PERIODIC TIME 0.5d0 y
    /

  SCREEN PERIODIC 100
  END

  #=====================TIME======================
  TIME
    FINAL_TIME 1.5d0 y 
    INITIAL_TIMESTEP_SIZE  24.d0 hr
    MINIMUM_TIMESTEP_SIZE  0.001d0 hr
    MAXIMUM_TIMESTEP_SIZE  336.0d0 hr
  END

  #==================REGIONS====================
  REGION all
    COORDINATES
      -1000.d0  -1000.d0  -1000.d0
      1000.d0  1000.d0  1000.d0
    /
  /

