#==================== SIMULATION ==================== 
SIMULATION
  SIMULATION_TYPE SUBSURFACE
    PROCESS_MODELS
        SUBSURFACE_FLOW flow
        MODE RICHARDS
        /
        SUBSURFACE_TRANSPORT transport 
        MODE GIRT 
        /
    /
  /
END

SUBSURFACE
  #==================== GRID ====================
  GRID
    TYPE structured     
    NXYZ 1 1 1
    DXYZ
      1.d0
      1.d0
      1.d0
    /
  END

  #==================== STRATA ===================
    STRATA
        REGION all
        MATERIAL gravel
    END

  #=========================== MATERIAL PROPERTIES ==============================
  MATERIAL_PROPERTY gravel
    ID  1
    POROSITY 0.25
    CHARACTERISTIC_CURVES sf
    PERMEABILITY 
      PERM_X  2.26E-11
      PERM_Y  2.26E-11
      PERM_Z  2.26E-11
    /
  /

  #=====================CHARACTERISTIC CURVES============
  CHARACTERISTIC_CURVES sf
    SATURATION_FUNCTION VAN_GENUCHTEN
      M 0.286
      ALPHA 1.9401d-4
      LIQUID_RESIDUAL_SATURATION 0.115
    /
    PERMEABILITY_FUNCTION MUALEM_VG_LIQ
      M 0.5
      LIQUID_RESIDUAL_SATURATION 0.115
    /
  /

  #=========================== fluid properties =================================
  FLUID_PROPERTY
    PHASE LIQUID
    DIFFUSION_COEFFICIENT 1.d-9
  END

  #===================OUTPUT=====================
  OUTPUT
    VELOCITY_AT_CENTER
    TIME_UNITS h
    SNAPSHOT_FILE
      FORMAT HDF5
      PERIODIC TIME 1.d0 h
    /

  SCREEN PERIODIC 100
  END

  #=====================TIME======================
  TIME
    FINAL_TIME 1000.d0 h
    INITIAL_TIMESTEP_SIZE  0.01d0 hr
    MINIMUM_TIMESTEP_SIZE  0.00001d0 hr
    MAXIMUM_TIMESTEP_SIZE  1.0d0 hr
  END

  #==================REGIONS====================
  REGION all
    COORDINATES
      -1000.d0  -1000.d0  -1000.d0
      1000.d0  1000.d0  1000.d0
    /
  /

  #========================FLOW CONDITION=============================
  FLOW_CONDITION initial
    TYPE
      LIQUID_PRESSURE hydrostatic
    /
    INTERPOLATION linear
    DATUM 1.d0 1.d0 1.5d0
    LIQUID_PRESSURE 101325.d0
  /



  #==================== CHEMISTRY ===================
  CHEMISTRY 
    PRIMARY_SPECIES 
      H+        
      H2O   
      Ac-    
      Al+++
      Ca++   
      Cl-         
      Fe++
      Fe+++
      HCO3-
      HS-
      K+
      Mg++ 
      N2(aq)
      Na+
      NO3-
      O2(aq)    
      SiO2(aq)
      SO4--  
      SOC(aq)
      Tracer 
    / 

    SECONDARY_SPECIES
      HAc(aq)
      S2--
      S2O3--
      CO(aq)
      ClO-
      ClO2-
      ClO3-
      ClO4-
      H2(aq)
      HSO5-
      NH3(aq)
      SO3--
      Al(OH)2+
      Al(SO4)2-
      !Al(OH)4-
      Al(OH)3(aq)
      AlOH++
      AlSO4+
      CO2(aq)
      CO3--
      CaCO3(aq)
      CaCl+
      CaCl2(aq)
      CaHCO3+
      CaNO3+
      CaOH+
      CaSO4(aq)
      CH4(aq)
      Fe(OH)2(aq)
      Fe(OH)2+
      Fe(OH)3(aq)
      Fe(OH)3-
      !Fe(OH)4-
      !Fe(OH)4--
      Fe(SO4)2-
      Fe2(OH)2++++
      Fe3(OH)4(5+)
      FeCO3(aq)
      FeCO3+
      FeCl+
      FeCl++
      FeCl2(aq)
      FeCl2+
      FeCl4-
      FeCl4--
      FeHCO3+
      FeNO3++
      FeOH+
      FeOH++
      FeSO4(aq)
      FeSO4+
      H2S(aq)
      H2SO4(aq)
      H2SiO4--
      HCl(aq)
      HNO3(aq)
      HO2-
      HS2O3-
      HSO4-
      H3SiO4-
      KCl(aq)
      KHSO4(aq)
      KOH(aq)
      KSO4-
      Mg4(OH)4++++
      MgCO3(aq)
      MgCl+
      MgHCO3+
      MgSO4(aq)
      NaAlO2(aq)
      NaCO3-
      NaCl(aq)
      NaHCO3(aq)
      NaHSiO3(aq)
      NaNO3(aq)
      NaOH(aq)
      NaSO4-
      OH-
      S--
      S5O6--
      SCN-
      H2SO3(aq)
      HClO(aq)
      HClO2(aq)
      HSO3-
      MgOH+
      NH4+
      NH4SO4-
      SO2(aq)
      Urea(aq)
    END   
 
    ACTIVE_GAS_SPECIES
      GAS_TRANSPORT_IS_UNVETTED
      CO2(g)*
      N2(g)
      O2(g)
    /
    
    PASSIVE_GAS_SPECIES
      CO2(g)*
      N2(g)
      O2(g)
    /

    MINERALS 
      Albite
      Calcite
      Dolomite
      Pyrite
    /

    DECOUPLED_EQUILIBRIUM_REACTIONS
        Fe++
        Fe+++
        HS-
        SO4--
    END 

    MINERAL_KINETICS 

      Albite
        PREFACTOR 
          RATE_CONSTANT 2.75d-13 
          ACTIVATION_ENERGY 69.8d0  !kJ / mol
          /
        PREFACTOR
          RATE_CONSTANT 6.92d-11 
          ACTIVATION_ENERGY 60.2d0  !kJ / mol
          PREFACTOR_SPECIES H+  
              ALPHA  0.457d0
          /
        /
        PREFACTOR
          RATE_CONSTANT 2.57d-08
          ACTIVATION_ENERGY 71.0d0  !kJ / mol
          PREFACTOR_SPECIES OH- 
              ALPHA  0.572
          /
        / 
      /

      Calcite
        PREFACTOR 
          RATE_CONSTANT 1.55d-06 
          ACTIVATION_ENERGY 23.5d0  !kJ / mol
          /
        PREFACTOR
          RATE_CONSTANT 5.01d-01 
          ACTIVATION_ENERGY 14.4d0  !kJ / mol
          PREFACTOR_SPECIES H+  
              ALPHA  1.0
          /
        /
        PREFACTOR
          RATE_CONSTANT 3.31d-04 
          ACTIVATION_ENERGY 35.4d0  !kJ / mol
          PREFACTOR_SPECIES HCO3-  
              ALPHA  1.0 
          /
        / 
      /

      Dolomite
        PREFACTOR 
          RATE_CONSTANT 2.51d-09
          ACTIVATION_ENERGY 95.31d0 !kJ / mol
          /
        PREFACTOR
          RATE_CONSTANT 1.74d-04
          ACTIVATION_ENERGY 56.69d0 !kJ / mol
          PREFACTOR_SPECIES H+  
              ALPHA  0.5
          /
        /
        PREFACTOR
          RATE_CONSTANT 4.27d-06 
          ACTIVATION_ENERGY 45.69d0 !kJ / mol
          PREFACTOR_SPECIES HCO3-  
              ALPHA  0.5 
          /
        / 
      /

      Pyrite
        PREFACTOR
          RATE_CONSTANT 7.94d-09
          ACTIVATION_ENERGY 56.9d0
          PREFACTOR_SPECIES H+  O2(aq)
              ALPHA  -0.11d0  0.5d0
          /
        /
        PREFACTOR
          RATE_CONSTANT 3.16d-10 
          ACTIVATION_ENERGY 56.9d0
          PREFACTOR_SPECIES H+  Fe++  Fe+++
            ALPHA  -0.32d0 -0.47d0  0.30d0
          /
        /
      /
    END

    SORPTION
      ION_EXCHANGE_RXN
        CEC 500.  ! eq/m^3
        CATIONS
          Na+   1.  REFERENCE  ! on product side of rxn; larger value indicates more aq. ion on product side 
          Ca++  0.012953  
          Mg++  0.1666
        /
      /
    END



    DATABASE hanford-cd.dat
    LOG_FORMULATION 
    ACTIVITY_COEFFICIENTS TIMESTEP 
    OUTPUT 
     all
     PRIMARY_SPECIES
     SECONDARY_SPECIES
     FREE_ION
     TOTAL
     pH
     MINERAL_SATURATION_INDEX
    /  
  END 

  #=========================== CONSTRAINTS ====================================== 
  CONSTRAINT  initial_gravel
    CONCENTRATIONS 
      H+          8.2       P
      H2O         1.00E+00  T
      Ac-         1.00E-06  T
      Al+++       1.41e-06  T
      Ca++        1.22e-03  T      
      Cl-         2.05e-05  Z
      Fe++        4.66E-10  T
      Fe+++       1.00E-15  T
      HCO3-       3.00e-4   G CO2(g)*   
      HS-         1.00e-7   T
      K+          2.07e-05  T
      Mg++        3.08e-04  T 
      N2(aq)      0.55      G N2(g)
      Na+         8.15e-05  T
      NO3-        2.07e-08  T
      O2(aq)      0.2       G O2(g)
      SiO2(aq)    1.63e-04  T
      SO4--       3.90E-04  T
      SOC(aq)     1.34d-04  T
      Tracer      1.00d-10  T 
    /

    MINERALS
      Albite           6.74e-02  2.90e+01
      Calcite          2.00e-02  1.10e+01 # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
      Dolomite         2.00e-02  1.07e+03 # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
      Pyrite           1.00e-03  1.90e+00
    /
  END


  #=========================== TRANSPORT CONDITIONS ============================= 
  TRANSPORT_CONDITION  initial_all
    TYPE zero_gradient 
      CONSTRAINT_LIST 
        0.d0  initial_gravel
      / 
  END 


  #========================INITIAL CONDITION==========================
  INITIAL_CONDITION initial
    FLOW_CONDITION initial
    TRANSPORT_CONDITION initial_all
    REGION all
  /

END_SUBSURFACE
