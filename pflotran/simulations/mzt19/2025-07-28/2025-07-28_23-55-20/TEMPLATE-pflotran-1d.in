#==================== SIMULATION ==================== 
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
    SUBSURFACE_TRANSPORT transport 
      MODE GIRT 
    /
  /
  RESTART
    FILENAME pflotran-1d_TIMESTAMP_spin-restart.chk
    RESET_TO_TIME_ZERO
  /
END

SUBSURFACE
  #==================== GRID ====================
  GRID
    TYPE structured     
    NXYZ 1 108 1
    DXYZ
      1.d0
      0.5d0
      1.d0
    /
  END

  #==================== STRATA ===================
    STRATA
        REGION all
        MATERIAL gravel
    END

  #=========================== MATERIAL PROPERTIES ==============================
  MATERIAL_PROPERTY gravel
    ID  1
    POROSITY 0.2
    CHARACTERISTIC_CURVES sf
    PERMEABILITY 
      PERM_X  5.26E-11
      PERM_Y  5.26E-11
      PERM_Z  5.26E-11
    /
  /

  #=====================CHARACTERISTIC CURVES============
  CHARACTERISTIC_CURVES sf
    SATURATION_FUNCTION VAN_GENUCHTEN
      M 0.286
      ALPHA 1.9401d-4
      LIQUID_RESIDUAL_SATURATION 0.115
    /
    PERMEABILITY_FUNCTION MUALEM_VG_LIQ
      M 0.5
      LIQUID_RESIDUAL_SATURATION 0.115
    /
  /

  #=========================== fluid properties =================================
  FLUID_PROPERTY
    PHASE LIQUID
    DIFFUSION_COEFFICIENT 1.d-9
  END

  FLUID_PROPERTY
    PHASE GAS
    DIFFUSION_COEFFICIENT 2.1d-5
  END

  #===================OUTPUT=====================
  OUTPUT
    VELOCITY_AT_CENTER
    TIME_UNITS hr
    SNAPSHOT_FILE
      FORMAT HDF5
      PERIODIC TIME 48.d0 hr
    /

  SCREEN PERIODIC 100
  END

  #=====================TIME======================
  TIME
    FINAL_TIME 3993.d0 hr
    INITIAL_TIMESTEP_SIZE  0.01d0 hr
    MINIMUM_TIMESTEP_SIZE  0.00001d0 hr
    MAXIMUM_TIMESTEP_SIZE  1.0d0 hr
  END

  #==================REGIONS====================
  REGION all
    COORDINATES
      -1000.d0  -1000.d0  -1000.d0
      1000.d0  1000.d0  1000.d0
    /
  /
!1
$%$%$% CHUNK DELIM %^%^%^

  #========================FLOW CONDITION=============================
  FLOW_CONDITION initial
    TYPE
      LIQUID_PRESSURE hydrostatic
    /
    INTERPOLATION linear
    DATUM 1.d0 1.d0 1.66d0
    LIQUID_PRESSURE 101325.d0
  /
!2
$%$%$% CHUNK DELIM %^%^%^

!3
$%$%$% CHUNK DELIM %^%^%^

  #=========================== CONSTRAINTS ====================================== 
  CONSTRAINT  initial_gravel
    CONCENTRATIONS 
      H+          8.2       P
      H2O         1.00E+00  T
      Ac-         1.00E-06  T
      Al+++       1.41e-06  T
      Ca++        1.22e-03  T      
      Cl-         2.05e-05  Z
      Fe++        4.66E-10  T
      Fe+++       1.00E-15  M Goethite 
      HCO3-       3.00e-04  G CO2(g)*   
      HS-         1.00e-07  T
      K+          2.07e-05  T
      Mg++        3.08e-04  T 
      N2(aq)      5.50e-01  G N2(g)
      Na+         8.15e-05  T
      NH3(aq)     1.00e-06  T
      NO3-        2.07e-08  T
      O2(aq)      0.16      G O2(g)
      SiO2(aq)    1.63e-04  T
      SO4--       3.90E-04  T
      SOC(aq)     1.34d-04  M SOC
      Tracer      1.00d-10  T 
    /

    IMMOBILE
      Fim       1.d-6
      Nim       1.d-4
      Sim       1.d-4
    /

    MINERALS
      Albite           6.74e-02  2.90e+01
     ! Calcite          1.00e-02  1.10e+01 # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
      Dolomite         2.00e-02  1.07e+03 # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
      Root_Respiration 1.00e-02  1.13e+05
      !Pyrite           1.00e-03  1.90e+00
      Ferrihydrite     0.00e-00  1.08e+07 # cm^2/cm^3   # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
      Goethite         3.72e-04  2.83e+06 # cm^2/cm^3   # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
      SOC              1.00e-02  1.13e+05 # cm^2/cm^3
      SOM              1.00e-02  1.13e+05 # cm^2/cm^3   # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
    /
  END
!4
$%$%$% CHUNK DELIM %^%^%^

  #=========================== TRANSPORT CONDITIONS ============================= 
  TRANSPORT_CONDITION  initial_all
    TYPE zero_gradient 
      CONSTRAINT_LIST 
        0.d0  initial_gravel
      / 
  END 
!5
$%$%$% CHUNK DELIM %^%^%^

  #======================BOUNDARY CONDITION==========================
!6
$%$%$% CHUNK DELIM %^%^%^

  #========================INITIAL CONDITION==========================
  INITIAL_CONDITION initial
    FLOW_CONDITION initial
    TRANSPORT_CONDITION initial_all
    REGION all
  /

END_SUBSURFACE