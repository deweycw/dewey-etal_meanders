! Generated 2026-02-05 12:41:20 (Local Time)
! Meander: MCP, Year: 2019

#==================== SIMULATION ==================== 
SIMULATION
  SIMULATION_TYPE SUBSURFACE
  PROCESS_MODELS
    SUBSURFACE_FLOW flow
      MODE RICHARDS
    /
    SUBSURFACE_TRANSPORT transport 
      MODE GIRT 
    /
  /
  RESTART
    FILENAME pflotran-mcp19_run114_spin-restart.chk
    RESET_TO_TIME_ZERO
  /
END

SUBSURFACE
  #==================== GRID ====================
  GRID
    TYPE structured     
    NXYZ 1 122 26
    DXYZ
      1.d0
      0.5d0
      0.10d0
    /
  END

  #==================== STRATA ===================
  STRATA
    FILE ../xxgrid010-mc-cxc-top.h5
  END

  #=========================== MATERIAL PROPERTIES ==============================
  MATERIAL_PROPERTY gravel
    ID  1
    POROSITY 0.2
    CHARACTERISTIC_CURVES sf
    PERMEABILITY 
      PERM_X  2.26E-11
      PERM_Y  2.26E-11
      PERM_Z  2.26E-11
    /
  /

  MATERIAL_PROPERTY  topsoil
    ID  2
    POROSITY 0.40
    CHARACTERISTIC_CURVES sf
    PERMEABILITY 
      PERM_X  1.055E-12
      PERM_Y  1.055E-12
      PERM_Z  1.055E-12
    /
  /

  #=====================CHARACTERISTIC CURVES============
  CHARACTERISTIC_CURVES sf
    SATURATION_FUNCTION VAN_GENUCHTEN
      M 0.286
      ALPHA 1.9401d-4
      LIQUID_RESIDUAL_SATURATION 0.115
    /
    PERMEABILITY_FUNCTION MUALEM_VG_LIQ
      M 0.5
      LIQUID_RESIDUAL_SATURATION 0.115
    /
  /

  #=========================== fluid properties =================================
  FLUID_PROPERTY
    PHASE LIQUID
    DIFFUSION_COEFFICIENT 1.d-9
  END

  FLUID_PROPERTY
    PHASE GAS
    DIFFUSION_COEFFICIENT 2.1d-5
  END

  #===================OUTPUT=====================
  OUTPUT
    VELOCITY_AT_CENTER
    TIME_UNITS h
    SNAPSHOT_FILE
      FORMAT HDF5
      PERIODIC TIME 24 h
    /
skip
    MASS_BALANCE_FILE
      PERIODIC TIME 24 h
      TOTAL_MASS_REGIONS
        all
        downstream_bc_reg
        upstream_bc_reg
      /
    /
noskip

  SCREEN PERIODIC 100
  END

  #=====================TIME======================
  TIME
    FINAL_TIME 3993.d0 h
    INITIAL_TIMESTEP_SIZE  0.01d0 hr
    MINIMUM_TIMESTEP_SIZE  0.00001d0 hr
    MAXIMUM_TIMESTEP_SIZE  0.5d0 hr
  END

  #==================REGIONS====================
