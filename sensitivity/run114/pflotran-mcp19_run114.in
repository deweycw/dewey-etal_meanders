      H2S(aq)
      H2SO4(aq)
      H2SiO4--
      HCl(aq)
      HNO3(aq)
      HO2-
      HS2O3-
      HSO4-
      H3SiO4-
      KCl(aq)
      KHSO4(aq)
      KOH(aq)
      KSO4-
      Mg4(OH)4++++
      MgCO3(aq)
      MgCl+
      MgHCO3+
      MgSO4(aq)
      NaAlO2(aq)
      NaCO3-
      NaCl(aq)
      NaHCO3(aq)
      NaHSiO3(aq)
      NaNO3(aq)
      NaOH(aq)
      NaSO4-
      OH-
      S--
      S5O6--
      SCN-
      H2SO3(aq)
      HClO(aq)
      HClO2(aq)
      HSO3-
      MgOH+
      NH4+
      NH4SO4-
      SO2(aq)
      Urea(aq) 
    END   
 
    ACTIVE_GAS_SPECIES
      GAS_TRANSPORT_IS_UNVETTED
      CO2(g)*
      N2(g)
      O2(g)
    /
    
    PASSIVE_GAS_SPECIES
      CO2(g)*
      O2(g)
      N2(g)
    /
    IMMOBILE_SPECIES
      Fim
      Nim
      Sim
    /

    MINERALS 
      Albite
      Calcite
      Dolomite
      Root_Respiration
      Ferrihydrite
      Goethite
      SOC
      SOM
    /

    DECOUPLED_EQUILIBRIUM_REACTIONS
        Fe++
        Fe+++
        HS-
        SO4--
        NO3-
        NH3(aq)
        N2(aq)
        O2(aq)
    END 

    MINERAL_KINETICS 
    
      Albite
        PREFACTOR 
          RATE_CONSTANT 2.75d-13 
          ACTIVATION_ENERGY 69.8d0  !kJ / mol
          /
        PREFACTOR
          RATE_CONSTANT 6.92d-11 
          ACTIVATION_ENERGY 60.2d0  !kJ / mol
          PREFACTOR_SPECIES H+  
              ALPHA  0.457d0
          /
        /
        PREFACTOR
          RATE_CONSTANT 2.57d-08
          ACTIVATION_ENERGY 71.0d0  !kJ / mol
          PREFACTOR_SPECIES OH- 
              ALPHA  0.572
          /
        / 
      /

      Calcite
        PREFACTOR 
          RATE_CONSTANT 3.339374d-06 
          ACTIVATION_ENERGY 23.5d0  !kJ / mol
          /
        PREFACTOR
          RATE_CONSTANT 5.01d-01 
          ACTIVATION_ENERGY 14.4d0  !kJ / mol
          PREFACTOR_SPECIES H+  
              ALPHA  1.0
          /
        /
        PREFACTOR
          RATE_CONSTANT 3.31d-04 
          ACTIVATION_ENERGY 35.4d0  !kJ / mol
          PREFACTOR_SPECIES HCO3-  
              ALPHA  1.0 
          /
        / 
      /

      Dolomite
        PREFACTOR 
          RATE_CONSTANT 2.51d-09
          ACTIVATION_ENERGY 95.31d0 !kJ / mol
          /
        PREFACTOR
          RATE_CONSTANT 1.74d-04
          ACTIVATION_ENERGY 56.69d0 !kJ / mol
          PREFACTOR_SPECIES H+  
              ALPHA  0.5
          /
        /
        PREFACTOR
          RATE_CONSTANT 4.27d-06 
          ACTIVATION_ENERGY 45.69d0 !kJ / mol
          PREFACTOR_SPECIES HCO3-  
              ALPHA  0.5 
          /
        / 
      /

      Ferrihydrite 
        RATE_CONSTANT 0.d0
      /

      Goethite 
        RATE_CONSTANT 0.d0
      /

      Root_Respiration
        DISSOLUTION_RATE_CONSTANT     1.710621d-12
        PRECIPITATION_RATE_CONSTANT   0.d0
      /

      SOC
        RATE_CONSTANT 1.00d-10
      /
      
      SOM        
        RATE_CONSTANT 0.d0 
      /
    /
  # ------- Fe++ oxidation ---------
    GENERAL_REACTION
      REACTION 1.00 Fe++ + 0.25 O2(aq) + H+ <-> 1.00 Fe+++ + 0.50 H2O
      FORWARD_RATE 1.d-10
      BACKWARD_RATE 0.d0
    /

  # ------- HS- oxidation ---------
    GENERAL_REACTION
      REACTION 1.00 HS- + 2.00 O2(aq) <-> 1.00 SO4-- + 1.00 H+
      FORWARD_RATE 1.d-10
      BACKWARD_RATE 0.d0
    /

  # ------- Aerobic respiration ---------
    MICROBIAL_REACTION
      REACTION 1.00 SOC(aq) + 1.00 O2(aq) + 1.00 H2O <-> 1.00 HCO3- + 1.00 H+
      RATE_CONSTANT 1.000000d-08
      MONOD
        SPECIES_NAME O2(aq)
        HALF_SATURATION_CONSTANT 1.000000d-03
        THRESHOLD_CONCENTRATION 1.d-6
      /
      MONOD
        SPECIES_NAME SOC(aq)
        HALF_SATURATION_CONSTANT 1.d-5
        THRESHOLD_CONCENTRATION 1.d-8
      /
    /

    REACTION_SANDBOX

      SOM_AC_FERMENTATION
        RATE        1.d-8
        THRESHOLD   1.d-6
      /

      JINBETHKE_NITRATE_ACETATE
        RMAX            2.154435d-06
        K_DONOR         4.641589d-06
        K_ACCEPTOR      2.154435d-05
        Y               1.0d-0
        M               2.667d0            ! 0.667 * 4
        CHI             8.0d0              ! 2.0 * 4
        O2_THRESHOLD    1.0d-4
      END

      JINBETHKE_FERRIHYDRITE_ACETATE
        RMAX            2.500000d-05
        K_DONOR         4.641589d-07
        K_ACCEPTOR      1.0d-6  ! vol fraction
        Y               1.0d-0
        M               0.50d0            ! 0.125 * 4
        CHI             7.0d0              ! 1.75 * 4
        O2_THRESHOLD    1.0d-5
      /

      JINBETHKE_GOETHITE_ACETATE
        RMAX            2.500000d-08
        K_DONOR         1.000000d-05
        K_ACCEPTOR      1.0d-6  ! vol fraction
        Y               1.0d-0
        M               0.50d0            ! 0.125 * 4
        CHI             7.0d0              ! 1.75 * 4
        O2_THRESHOLD    1.0d-5
        K_PRECIPITATION 1.0d-30
      /

      JINBETHKE_SULFATE_ACETATE
        RMAX            2.500000d-08
        K_DONOR         5.000000d-05
        K_ACCEPTOR      1.000000d-03
        Y               1.0d-0
        M               1.33d0            ! 0.33 * 4.0
        CHI             8.0d0              ! 2.0 * 4.0
        O2_THRESHOLD    1.0d-5
      END
    /
  
    DATABASE ../hanford-cd.dat
    LOG_FORMULATION 
    ACTIVITY_COEFFICIENTS TIMESTEP 
    OUTPUT 
     all
     PRIMARY_SPECIES
     SECONDARY_SPECIES
     FREE_ION
     TOTAL
     pH
     MINERAL_SATURATION_INDEX
    /  
  END

