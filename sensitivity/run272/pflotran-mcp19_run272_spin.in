  #=========================== TRANSPORT CONDITIONS ============================= 
  TRANSPORT_CONDITION  initial_all
    TYPE zero_gradient 
      CONSTRAINT_LIST 
        0.d0  initial_gravel
      / 
  END 
  TRANSPORT_CONDITION  initial_soil
    TYPE zero_gradient 
      CONSTRAINT_LIST 
        0.d0  initial_soil
      / 
  END 
  TRANSPORT_CONDITION  initial_gravel
    TYPE zero_gradient 
      CONSTRAINT_LIST 
        0.d0  initial_gravel
      / 
