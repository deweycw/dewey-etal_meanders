        PREFACTOR
          RATE_CONSTANT 3.31d-04 
          ACTIVATION_ENERGY 35.4d0  !kJ / mol
          PREFACTOR_SPECIES HCO3-  
              ALPHA  1.0 
          /
        / 
      /

      Dolomite
        PREFACTOR 
          RATE_CONSTANT 2.51d-09
          ACTIVATION_ENERGY 95.31d0 !kJ / mol
          /
        PREFACTOR
          RATE_CONSTANT 1.74d-04
          ACTIVATION_ENERGY 56.69d0 !kJ / mol
          PREFACTOR_SPECIES H+  
              ALPHA  0.5
          /
        /
        PREFACTOR
          RATE_CONSTANT 4.27d-06 
          ACTIVATION_ENERGY 45.69d0 !kJ / mol
          PREFACTOR_SPECIES HCO3-  
              ALPHA  0.5 
          /
        / 
      /

      Ferrihydrite 
        RATE_CONSTANT 0.d0
      /

      Goethite 
        RATE_CONSTANT 0.d0
      /

      Root_Respiration
        DISSOLUTION_RATE_CONSTANT     3.685422d-13
        PRECIPITATION_RATE_CONSTANT   0.d0
      /

      SOC
        RATE_CONSTANT 1.00d-10
      /
      
      SOM        
        RATE_CONSTANT 0.d0 
      /

    /
    # ------- Fe++ oxidation ---------
    GENERAL_REACTION
      REACTION 1.00 Fe++ + 0.25 O2(aq) + H+ <-> 1.00 Fe+++ + 0.50 H2O
      FORWARD_RATE 1.d-10
      BACKWARD_RATE 0.d0
    /

    # ------- HS- oxidation ---------
    GENERAL_REACTION
      REACTION 1.00 HS- + 2.00 O2(aq) <-> 1.00 SO4-- + 1.00 H+
      FORWARD_RATE 1.d-10
      BACKWARD_RATE 0.d0
    /

    # ------- Aerobic respiration ---------
    MICROBIAL_REACTION
      REACTION 1.00 SOC(aq) + 1.00 O2(aq) + 1.00 H2O <-> 1.00 HCO3- + 1.00 H+
      RATE_CONSTANT 4.641589d-10
      MONOD
        SPECIES_NAME O2(aq)
        HALF_SATURATION_CONSTANT 4.641589d-05
        THRESHOLD_CONCENTRATION 1.d-6
      /
      MONOD
        SPECIES_NAME SOC(aq)
        HALF_SATURATION_CONSTANT 1.d-5
        THRESHOLD_CONCENTRATION 1.d-8
      /
    /

    REACTION_SANDBOX

      SOM_AC_FERMENTATION
        RATE        1.d-8
        THRESHOLD   1.d-6
      /

      JINBETHKE_NITRATE_ACETATE
        RMAX            2.154435d-06
        K_DONOR         1.000000d-04
        K_ACCEPTOR      4.641589d-06
        Y               1.0d-0
        M               2.667d0            ! 0.667 * 4
        CHI             8.0d0              ! 2.0 * 4
        O2_THRESHOLD    1.0d-4
      END

      JINBETHKE_FERRIHYDRITE_ACETATE
        RMAX            5.386087d-07
        K_DONOR         4.641589d-06
        K_ACCEPTOR      1.0d-6  ! vol fraction
        Y               1.0d-0
        M               0.50d0            ! 0.125 * 4
        CHI             7.0d0              ! 1.75 * 4
        O2_THRESHOLD    1.0d-5
      /

      JINBETHKE_GOETHITE_ACETATE
        RMAX            1.160397d-07
        K_DONOR         2.154435d-06
        K_ACCEPTOR      1.0d-6  ! vol fraction
        Y               1.0d-0
        M               0.50d0            ! 0.125 * 4
        CHI             7.0d0              ! 1.75 * 4
        O2_THRESHOLD    1.0d-5
        K_PRECIPITATION 1.0d-30
      /

      JINBETHKE_SULFATE_ACETATE
        RMAX            2.500000d-06
        K_DONOR         5.000000d-05
        K_ACCEPTOR      1.000000d-03
        Y               1.0d-0
        M               1.33d0            ! 0.33 * 4.0
        CHI             8.0d0              ! 2.0 * 4.0
        O2_THRESHOLD    1.0d-5
      END

    /

    DATABASE ../hanford-cd.dat
    LOG_FORMULATION 
    ACTIVITY_COEFFICIENTS TIMESTEP 
    OUTPUT 
     all
     PRIMARY_SPECIES
     SECONDARY_SPECIES
     FREE_ION
     TOTAL
     pH
     MINERAL_SATURATION_INDEX
    /  
  END

  #=========================== CONSTRAINTS ====================================== 
  CONSTRAINT  initial_gravel
    CONCENTRATIONS 
      H+          8.2       P
      H2O         1.00E+00  T
      Ac-         1.00E-06  T
      Al+++       1.41e-06  T
      Ca++        1.22e-03  T      
      Cl-         2.05e-05  T
      Fe++        4.66E-10  T
      Fe+++       1.00E-15  M Goethite 
      HCO3-       3.00e-04  G CO2(g)*   
      HS-         1.00e-07  T
      K+          2.07e-05  T
      Mg++        3.08e-04  T 
      N2(aq)      5.50e-01  G N2(g)
      Na+         8.15e-05  T
      NH3(aq)     1.00e-06  T
      NO3-        2.07e-08  T
      O2(aq)      0.16      G O2(g)
      SiO2(aq)    1.63e-04  T
      SO4--       3.90E-04  T
      SOC(aq)     1.34d-04  M SOC
      Tracer      1.00d-10  T 
    /

    IMMOBILE
      Fim       1.d-10 !1.d-6
      Nim       1.d-10 !1.d-4
      Sim       1.d-10 !1.d-4
    /

    MINERALS
      Albite           6.74e-02  0.10e+00 m^2/g     # min_name     vol_frac     spe_sur_area [m2 mineral/m3 bulk]
      Calcite          1.00e-03  1.10e+01 
      Dolomite         1.00e-02  1.82e+00 m^2/g
      Root_Respiration 1.00e-02  1.13e+05
      Ferrihydrite     0.00e-00  2.326789e+07 
      Goethite         3.72e-04  2.830000e+05
      SOC              1.00e-02  1.13e+05 
      SOM              1.00e-02  1.13e+05
    /
  END

  CONSTRAINT  initial_soil
