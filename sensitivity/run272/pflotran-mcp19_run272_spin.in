  TRANSPORT_CONDITION  from_river
    TYPE dirichlet_zero_gradient 
      CONSTRAINT_LIST 
        0.d0  river
      / 
  END 
  TRANSPORT_CONDITION  from_precip
    TYPE zero_gradient 
      CONSTRAINT_LIST 
        0.d0  precip
      / 
  END 

