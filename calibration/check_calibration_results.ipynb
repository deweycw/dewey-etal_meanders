    "    ('5D',60.0,2.5, '2019-08-28', 3.23e-3, 6.66e-5, 7.77, 1.27e-3),\n",
    "    ('5D',60.0,2.5, '2019-09-15', 3.00e-3, 1.03e-4, 7.43, 1.22e-3),\n",
