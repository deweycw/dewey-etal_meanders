Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Christian Dewey <cdewey@udel.edu>
    Description Python post-processing environment for PFLOTRAN meander simulations

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-dev \
        libhdf5-dev \
        pkg-config \
        git \
        && rm -rf /var/lib/apt/lists/*

    # Upgrade pip
    python3 -m pip install --no-cache-dir --upgrade pip setuptools

    # Clone and install pflotranutils (includes numpy, matplotlib, scipy, pandas, h5py, seaborn)
    git clone --single-branch --branch meanders https://github.com/deweycw/pflotran-utils.git /opt/pflotran-utils
    python3 -m pip install --no-cache-dir /opt/pflotran-utils

    # Additional dependencies
    python3 -m pip install --no-cache-dir scikit-learn pyyaml

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export MPLCONFIGDIR=/tmp/matplotlib

%runscript
    exec python3 "$@"

%test
    python3 -c "from pflotranutils.processor import PflotranProcessor; print('pflotranutils OK')"
    python3 -c "import sklearn; print('scikit-learn OK')"
